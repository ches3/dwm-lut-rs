import { Palette } from "std-widgets.slint";

export component BusyIndicator {
    width: 18px;
    height: 18px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    path := Path {
        private property <float> radius: min(self.viewbox-width, self.viewbox-height) / 2 - 10;
        private property <float> start-x: self.viewbox-width / 2;
        private property <float> start-y: self.viewbox-height / 2;
        private property <float> start: mod(animation-tick(), 1s) / 1s;
        private property <float> progress: 0.75;

        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        stroke-width: 3px;
        stroke: Palette.foreground;

        MoveTo {
            x: path.start-x - path.radius * sin(-(path.start - 0.001) * 360deg);
            y: path.start-y - path.radius * cos(-(path.start - 0.001) * 360deg);
        }
        LineTo {
            x: path.start-x - path.radius * sin(-path.start * 360deg);
            y: path.start-y - path.radius * cos(-path.start * 360deg);
        }
        ArcTo {
            radius-x: path.radius;
            radius-y: path.radius;
            x: path.start-x - path.radius * sin(-(path.start + path.progress) * 360deg);
            y: path.start-y - path.radius * cos(-(path.start + path.progress) * 360deg);
            sweep: true;
            large-arc: true;
        }
    }
}

export component CloseButton {
    in property <bool> enabled: true;
    callback clicked;

    width: 32px;
    height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    opacity: root.enabled ? 1 : 0.4;

    Rectangle {
        border-radius: 16px;
        background: Palette.control-background;

        Path {
            width: 40%;
            height: 40%;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            stroke-width: 1.5px;
            stroke: Palette.control-foreground;
            viewbox-x: -1;
            viewbox-y: -1;
            viewbox-width: 2;
            viewbox-height: 2;
            MoveTo {
                x: -0.7;
                y: -0.7;
            }
            LineTo {
                x: 0.7;
                y: 0.7;
            }
            MoveTo {
                x: -0.7;
                y: 0.7;
            }
            LineTo {
                x: 0.7;
                y: -0.7;
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }

        Rectangle {
            border-radius: 16px;
            background: touch.pressed
                ? (Palette.color-scheme == ColorScheme.dark ? #16161680 : #BEBEBE80)
                : touch.has-hover ? #63636333 : transparent;
        }
    }
}

export component ModalOverlay {
    callback close;
    in property <length> panel-max-width: 420px;

    width: 100%;
    height: 100%;

    Rectangle {
        background: #000000b4;
        width: 100%;
        height: 100%;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => {
                root.close();
            }
            scroll-event(_) => {
                accept
            }
        }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(root.panel-max-width, parent.width - 40px);
            height: min(content.preferred-height, parent.height - 40px);
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000066;

            content := TouchArea {
                width: 100%;
                height: 100%;
                scroll-event(_) => {
                    reject
                }

                @children
            }
        }
    }
}
