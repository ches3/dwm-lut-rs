import {
    Button,
    ComboBox,
    Palette,
    ScrollView,
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";
import { BusyIndicator, ModalOverlay } from "./widgets.slint";
import { ManageProfilesOverlay, ProfileNameEditKind } from "./manage-profiles.slint";
import { SettingsOverlay, HostSettings } from "./settings.slint";

export { HostTray, TrayProfile } from "./tray.slint";
export { ProfileNameEditKind } from "./manage-profiles.slint";
export { HostSettings } from "./settings.slint";

export struct MonitorRow {
    device-path: string,
    title: string,
    connected: bool,
    sdr-path: string,
    hdr-path: string,
    has-sdr: bool,
    has-hdr: bool,
}

export component MainWindow inherits Window {
    title: "dwm-lut";
    icon: @image-url("../assets/icon.png");
    preferred-width: 800px;
    preferred-height: 580px;
    min-width: root.load-failed ? 480px : 720px;
    min-height: root.load-failed ? 220px : 480px;
    default-font-family: "Segoe UI";
    default-font-size: 13px;

    forward-focus: app-focus;

    in property <bool> load-failed: false;
    in property <string> load-error: "";
    in property <bool> controls-disabled: false;
    in property <bool> main-controls-disabled: false;
    in property <bool> suppress-mouse-focus-dismiss: false;
    in property <bool> disable-available: true;
    in property <bool> can-exit: true;
    in property <bool> mutation-busy: false;
    in property <string> hook-status: "Checking...";
    in property <string> monitor-error: "";
    in property <[string]> profile-names;
    in-out property <int> selected-profile-index: 0;
    private property <string> selected-profile:
        root.selected-profile-index >= 0 && root.selected-profile-index < root.profile-names.length
            ? root.profile-names[root.selected-profile-index]
            : "";
    in property <int> default-profile-index: 0;
    private property <string> default-profile:
        root.default-profile-index >= 0 && root.default-profile-index < root.profile-names.length
            ? root.profile-names[root.default-profile-index]
            : "";
    in property <[MonitorRow]> monitors;
    in property <string> error-message: "";
    in property <string> delete-dialog-profile: "";
    in property <bool> settings-open: false;
    in property <int> settings-focus-nonce: 0;
    in property <bool> manage-profiles-open: false;
    in property <ProfileNameEditKind> profile-name-edit-kind: ProfileNameEditKind.none;
    in property <string> profile-name-edit-original: "";
    in-out property <string> profile-name-edit-input: "";
    in property <string> profile-name-edit-error: "";
    in property <int> profile-name-edit-focus-nonce: 0;
    in property <bool> apply-on-start: false;
    in property <bool> flip-gate-enabled: true;

    callback apply();
    callback disable();
    callback reload-config();
    callback exit();
    callback profile-selected(string);
    callback add-profile();
    callback rename-profile(string);
    callback delete-profile(string);
    callback set-default-profile(string);
    callback open-manage-profiles();
    callback close-manage-profiles();
    callback open-settings();
    callback close-settings();
    callback settings-changed(HostSettings);
    callback browse-lut(string, bool);
    callback clear-lut(string, bool);
    callback error-dismiss();
    callback delete-confirm();
    callback delete-cancel();
    callback profile-name-edit-commit();
    callback profile-name-edit-cancel();
    callback dismiss-top();

    public function restore-default-focus() {
        app-focus.focus();
    }

    app-focus := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: true;

        capture-key-pressed(event) => {
            if (event.text != Key.Escape) {
                return reject;
            }
            root.dismiss-top();
            accept
        }

        VerticalBox {
            padding: 0px;
            spacing: 10px;

            if root.load-failed: VerticalBox {
                padding: 16px;
                spacing: 12px;
                alignment: start;
                vertical-stretch: 1;

                Text {
                    text: "Failed to load configuration";
                    font-size: 18px;
                    font-weight: 700;
                }
                Text {
                    text: root.load-error;
                    wrap: word-wrap;
                }
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    vertical-stretch: 0;
                    alignment: start;
                    Button {
                        text: "Reload";
                        enabled: !root.main-controls-disabled;
                        clicked => {
                            root.reload-config();
                        }
                    }
                    Button {
                        text: "Exit";
                        enabled: root.can-exit;
                        clicked => {
                            root.exit();
                        }
                    }
                }
            }

            if !root.load-failed: VerticalBox {
                spacing: 0;
                vertical-stretch: 1;

                HorizontalBox {
                    spacing: 8px;
                    Text {
                        text: "Profile";
                        vertical-alignment: center;
                    }
                    ComboBox {
                        horizontal-stretch: 0;
                        model: root.profile-names;
                        current-index <=> root.selected-profile-index;
                        enabled: !root.main-controls-disabled;
                        selected(value) => {
                            root.profile-selected(value);
                        }
                    }
                    if root.selected-profile == root.default-profile: Text {
                        text: "(default)";
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Button {
                            text: "Manage Profiles";
                            enabled: !root.main-controls-disabled;
                            clicked => {
                                root.open-manage-profiles();
                            }
                        }
                        Button {
                            text: "Settings";
                            enabled: !root.main-controls-disabled;
                            clicked => {
                                root.open-settings();
                            }
                        }
                    }
                }

                if root.monitor-error != "": Text {
                    text: "Failed to refresh monitors: \{root.monitor-error}";
                    color: #d9534f;
                    wrap: word-wrap;
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalBox {
                        alignment: start;
                        spacing: 4px;
                        padding-top: 2px;
                        padding-bottom: 2px;
                        padding-left: 0px;
                        padding-right: 6px;

                        if root.monitors.length == 0: Text {
                            text: "No active monitors or saved assignments.";
                        }

                        for monitor in root.monitors: VerticalBox {
                            padding: 10px;
                            spacing: 8px;

                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;
                                Text {
                                    text: monitor.title;
                                    font-size: 14px;
                                    font-weight: 600;
                                    color: monitor.connected ? Palette.foreground : Palette.foreground.transparentize(0.4);
                                }
                                if !monitor.connected: Text {
                                    text: "Disconnected";
                                    color: Palette.foreground.transparentize(0.4);
                                    vertical-alignment: center;
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "SDR LUT";
                                    width: 64px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: monitor.sdr-path;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    color: Palette.foreground.transparentize(0.15);
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: "Browse";
                                    enabled: !root.main-controls-disabled;
                                    clicked => {
                                        root.browse-lut(monitor.device-path, false);
                                    }
                                }
                                Button {
                                    text: "Clear";
                                    enabled: !root.main-controls-disabled && monitor.has-sdr;
                                    clicked => {
                                        root.clear-lut(monitor.device-path, false);
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "HDR LUT";
                                    width: 64px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: monitor.hdr-path;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    color: Palette.foreground.transparentize(0.15);
                                    vertical-alignment: center;
                                }
                                Button {
                                    text: "Browse";
                                    enabled: !root.main-controls-disabled;
                                    clicked => {
                                        root.browse-lut(monitor.device-path, true);
                                    }
                                }
                                Button {
                                    text: "Clear";
                                    enabled: !root.main-controls-disabled && monitor.has-hdr;
                                    clicked => {
                                        root.clear-lut(monitor.device-path, true);
                                    }
                                }
                            }
                        }
                    }
                }

                HorizontalBox {
                    alignment: space-between;
                    cross-axis-alignment: end;
                    padding-top: 16px;
                    spacing: 12px;
                    Text {
                        text: "Status: \{root.hook-status}";
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        if root.mutation-busy: VerticalLayout {
                            alignment: center;
                            BusyIndicator {}
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Apply";
                                enabled: !root.main-controls-disabled;
                                clicked => {
                                    root.apply();
                                }
                            }
                            Button {
                                text: "Disable";
                                enabled: !root.main-controls-disabled && root.disable-available;
                                clicked => {
                                    root.disable();
                                }
                            }
                        }
                    }
                }
            }
        }

        if root.manage-profiles-open: ManageProfilesOverlay {
            profile-names: root.profile-names;
            default-profile-index: root.default-profile-index;
            controls-disabled: root.controls-disabled;
            edit-kind: root.profile-name-edit-kind;
            edit-original: root.profile-name-edit-original;
            edit-input <=> root.profile-name-edit-input;
            edit-error: root.profile-name-edit-error;
            edit-focus-nonce: root.profile-name-edit-focus-nonce;
            delete-dialog-profile: root.delete-dialog-profile;
            close => {
                root.close-manage-profiles();
            }
            set-default-profile(name) => {
                root.set-default-profile(name);
            }
            rename-profile(name) => {
                root.rename-profile(name);
            }
            delete-profile(name) => {
                root.delete-profile(name);
            }
            add-profile => {
                root.add-profile();
            }
            edit-commit => {
                root.profile-name-edit-commit();
            }
            edit-cancel => {
                root.profile-name-edit-cancel();
            }
            delete-confirm => {
                root.delete-confirm();
            }
            delete-cancel => {
                root.delete-cancel();
            }
        }

        if root.settings-open: SettingsOverlay {
            apply-on-start: root.apply-on-start;
            flip-gate-enabled: root.flip-gate-enabled;
            focus-nonce: root.settings-focus-nonce;
            controls-disabled: root.controls-disabled;
            close => {
                root.close-settings();
            }
            changed(settings) => {
                root.settings-changed(settings);
            }
        }

        if root.error-message != "": ModalOverlay {
            panel-max-width: 360px;
            close => {
                root.error-dismiss();
            }

            VerticalBox {
                padding: 16px;
                spacing: 16px;

                Text {
                    text: "Error";
                    font-size: 16px;
                    font-weight: 700;
                }

                Text {
                    text: root.error-message;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    Button {
                        text: "OK";
                        clicked => {
                            root.error-dismiss();
                        }
                    }
                }
            }
        }
    }
}
